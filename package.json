{
  "name": "skyhedge",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:site": "VITE_STATIC_PREVIEW=true vite build",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "typecheck": "tsc",
    "test:line": "node --import tsx --test shared/ui-line.test.ts",
    "db:push": "drizzle-kit push",
    "solana:test": "cargo-build-sbf --manifest-path anchor/Cargo.toml && cargo +nightly test --manifest-path anchor/Cargo.toml",
    "solana:check": "cargo +nightly check --manifest-path anchor/Cargo.toml",
    "solana:build": "cd anchor && RUSTUP_TOOLCHAIN=1.89.0 anchor build --no-idl -- --optimize-size",
    "solana:test-local": "cd anchor && RUSTUP_TOOLCHAIN=nightly-2024-08-01 anchor test --skip-build",
    "skyt:airdrop": "tsx scripts/airdrop-sol.ts",
    "skyt:mint": "tsx scripts/create-skyt-mint.ts",
    "skyt:init": "tsx scripts/init-protocol.ts",
    "skyt:seed": "tsx scripts/seed-markets.ts",
    "skyt:status": "tsx scripts/status.ts",
    "skyt:deploy": "bash scripts/deploy-devnet.sh",
    "skyt:demo": "SOLANA_RPC_URL=http://127.0.0.1:8899 SOLANA_NETWORK=localnet tsx scripts/demo-localnet.ts",
    "test:server": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 60000 'server/services/*.test.ts'",
    "test:deployment": "node --test scripts/deployment-buffer.test.mjs",
    "test:ui": "playwright test",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@scure/base": "^1.2.6",
    "@solana/kit": "^5.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.60.5",
    "@types/bn.js": "^5.1.5",
    "@vercel/functions": "^3.10.1",
    "@x402/core": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "framer-motion": "^11.13.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^6.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "util": "^0.12.5",
    "vaul": "^1.1.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@replit/vite-plugin-cartographer": "^0.2.7",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/leaflet": "^1.9.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "chai": "^4.5.0",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.19",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "11.1.0"
    },
    "shell-quote": "1.11.0"
  },
  "description": "Devnet-only Solana rainfall protection",
  "packageManager": "npm@10.9.0"
}
