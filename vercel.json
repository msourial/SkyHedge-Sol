{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/settlement.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/settlement", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
