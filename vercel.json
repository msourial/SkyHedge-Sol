{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/settlement.ts": {
      "maxDuration": 300
    },
    "api/cron/windows.ts": {
      "maxDuration": 300
    },
    "api/window-evidence.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/settlement",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/windows",
      "schedule": "15 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/markets/:market/positions/:wallet/claim-readiness",
      "destination": "/api/mobile?resource=claim-readiness&market=:market&wallet=:wallet"
    },
    {
      "source": "/api/waitlist/export",
      "destination": "/api/waitlist?action=export"
    },
    {
      "source": "/api/waitlist/count",
      "destination": "/api/waitlist?action=count"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
