{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/settlement.ts": {
      "maxDuration": 300
    },
    "api/cron/windows.ts": {
      "maxDuration": 300
    },
    "api/devnet/status.ts": {
      "maxDuration": 120
    },
    "api/quotes.ts": {
      "maxDuration": 30
    },
    "api/x402/quote.ts": {
      "maxDuration": 60
    },
    "api/transactions/unsigned.ts": {
      "maxDuration": 30
    },
    "api/advisory.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/settlement",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/windows",
      "schedule": "15 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/markets/des-moines/evidence-package",
      "destination": "/api/evidence-package"
    },
    {
      "source": "/api/markets/:market/positions/:wallet/claim-readiness",
      "destination": "/api/mobile?resource=claim-readiness&market=:market&wallet=:wallet"
    },
    {
      "source": "/api/waitlist/export",
      "destination": "/api/waitlist?action=export"
    },
    {
      "source": "/api/waitlist/count",
      "destination": "/api/waitlist?action=count"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci && npm --prefix mobile ci"
}
