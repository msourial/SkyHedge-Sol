# --- Application ---
# Network the server reads from (localnet | devnet | mainnet-beta)
SOLANA_NETWORK=devnet
# HTTP port (defaults to 5000)
# PORT=5000

# --- Weather data ---
# NOAA Climate Data Online token (https://www.ncdc.noaa.gov/cdo-web/token)
NOAA_TOKEN=

# --- Optional read-model database ---
# Not required for the Devnet V1 launch path. Add later for analytics and fast history.
DATABASE_URL=

# --- AI advisory ---
ANTHROPIC_API_KEY=

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SKYHEDGE_PROGRAM_ID=5hGLEG1ts46iER4pfWnP1fMb8sG5nxSinNY1pjYnNPWx
VITE_SKYHEDGE_PROGRAM_ID=5hGLEG1ts46iER4pfWnP1fMb8sG5nxSinNY1pjYnNPWx
VITE_PROTOCOL_ADMIN=DKA9RkGvaW4isyj5xdiZ2oGVUkD1UL64Ha1BazXZFD6y
VITE_SETTLEMENT_AUTHORITY=AVe5ULAoAyDaXAPS7s2sAUJo7A2QmDuph9Nwyrm9v5Vh
VITE_SKYT_MINT=3Y1SaGnJiPez3hkcHom2gimtVEm7W7R8imeRMPTUaK9g
# Server-only supplemental evidence. Never use this key in VITE_* variables.
WEATHERXM_API_KEY=
# The owner wallet that must sign the protocol initialization transaction.
PROTOCOL_ADMIN=DKA9RkGvaW4isyj5xdiZ2oGVUkD1UL64Ha1BazXZFD6y
# Settlement authority signer (never the admin wallet); its private key is local-only.
SETTLEMENT_AUTHORITY_KEYPAIR=anchor/keys/settlement-authority.json
# Six-decimal SKYT Devnet test mint. Its authority must be the protocol-admin wallet.
SKYT_MINT=3Y1SaGnJiPez3hkcHom2gimtVEm7W7R8imeRMPTUaK9g
