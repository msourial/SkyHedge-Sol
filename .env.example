# --- Application ---
# Network the server reads from (localnet | devnet | mainnet-beta)
SOLANA_NETWORK=devnet
# HTTP port (defaults to 5000)
# PORT=5000

# --- Weather data ---
# NOAA Climate Data Online token (https://www.ncdc.noaa.gov/cdo-web/token)
NOAA_TOKEN=

# --- Optional read-model database ---
# Not required for the Devnet V1 launch path. Required for waitlist signup persistence.
DATABASE_URL=

# --- Waitlist admin (skyhedge.app) ---
# Long random secret for GET /api/waitlist/export and GET /api/waitlist/count (Bearer or x-admin-token).
ADMIN_TOKEN=
# Salt used to hash client IPs before rate-limiting / storage (never store raw IPs).
IP_HASH_SALT=

# --- AI advisory ---
# Primary: OpenRouter (key format sk-or-v1-...). Fallback: Anthropic. With neither, the guide answers in labelled offline mode.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-sonnet-5-5. Keep this server-side.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SKYHEDGE_PROGRAM_ID=5hGLEG1ts46iER4pfWnP1fMb8sG5nxSinNY1pjYnNPWx
VITE_SKYHEDGE_PROGRAM_ID=5hGLEG1ts46iER4pfWnP1fMb8sG5nxSinNY1pjYnNPWx
SKYHEDGE_DEVNET_CANCEL_EMPTY_DRAFT_READY=false
VITE_PROTOCOL_ADMIN=DKA9RkGvaW4isyj5xdiZ2oGVUkD1UL64Ha1BazXZFD6y
VITE_SETTLEMENT_AUTHORITY=AVe5ULAoAyDaXAPS7s2sAUJo7A2QmDuph9Nwyrm9v5Vh
VITE_SKYT_MINT=3Y1SaGnJiPez3hkcHom2gimtVEm7W7R8imeRMPTUaK9g
VITE_MAP_PROVIDER=maptiler
# Browser-visible MapTiler key. Restrict this key by domain in MapTiler before production use.
# Allowlist: skyhedge.app, www.skyhedge.app, and keep skyhedge.vercel.app so the legacy alias still works.
VITE_MAPTILER_KEY=
# Optional public map share base URL. If omitted, SkyHedge links larger-map views to OpenStreetMap.
VITE_MAPTILER_SHARE_BASE_URL=
# Canonical public site is https://skyhedge.app (code defaults for mobile API + MWA identity).
# Mobile release builds: EXPO_PUBLIC_API_BASE_URL=https://skyhedge.app
# Optional web API base (leave empty on Vercel for same-origin /api):
# VITE_API_BASE_URL=
# Optional WeatherXM Agent API base URL. The default integration uses only its free health endpoint.
WEATHERXM_AGENT_BASE_URL=https://agent.weatherxm.com
# The owner wallet that must sign the protocol initialization transaction.
PROTOCOL_ADMIN=DKA9RkGvaW4isyj5xdiZ2oGVUkD1UL64Ha1BazXZFD6y
# Settlement authority signer (never the admin wallet); its private key is local-only.
SETTLEMENT_AUTHORITY_KEYPAIR=anchor/keys/settlement-authority.json
# Six-decimal SKYT Devnet test mint. Its authority must be the protocol-admin wallet.
SKYT_MINT=3Y1SaGnJiPez3hkcHom2gimtVEm7W7R8imeRMPTUaK9g
