{
  "include": [
    "api/**/*.ts",
    "client/src/App.tsx",
    "client/src/main.tsx",
    "client/src/pages/*.tsx",
    "client/src/components/ui/**/*",
    "client/src/components/*.tsx",
    "client/src/lib/*.ts",
    "shared/schema.ts",
    "shared/public-origins.ts",
    "shared/storm-glass.ts",
    "server/services/cors.ts",
    "server/index.ts",
    "server/routes.ts",
    "server/vite.ts",
    "server/db.ts",
    "server/services/noaa.ts",
    "server/services/city-index.ts",
    "server/services/quote-engine.ts",
    "server/services/x402-facilitator.ts",
    "server/services/x402-quote.ts",
    "server/services/x402-quote-body.ts",
    "server/services/x402-settlement.ts",
    "server/services/consensus.ts",
    "server/services/methodology.ts",
    "server/services/solana-indexer.ts",
    "server/services/unsigned-tx.ts",
    "server/services/vercel-api.ts",
    "server/services/devnet-status.ts",
    "server/services/rpc-failover.ts",
    "server/services/tester-readiness.ts",
    "server/services/advisory.ts",
    "server/services/advisory-api.ts",
    "server/services/canadian-pilots.ts",
    "server/services/settlement.ts",
    "server/services/settlement-constants.ts",
    "server/services/ghcnd-daily.ts",
    "server/services/methodology-docs.ts",
    "server/services/noaa-element.ts",
    "server/services/peril-consensus.ts",
    "server/services/window-quote.ts",
    "server/services/window-quote-read.ts",
    "server/services/demo-keeper-plan.ts",
    "server/services/window-keeper.ts",
    "server/services/window-keeper-run.ts",
    "shared/perils.ts",
    "shared/rung-plan.ts",
    "shared/ui-quote-types.ts",
    "scripts/demo-localnet.ts",
    "scripts/x402-agent-demo.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}
